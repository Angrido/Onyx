    "@prisma/client": "7.10.0",
    "better-sqlite3": "^12.6.0",
    "fastify": "^5.12.5",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@onyx/config": "workspace:*",
    "@types/node": "^22.20.5",
    "@types/ws": "^8.18.2",
    "pino-pretty": "^13.1.3",
