#!/usr/bin/env bash
set -euo pipefail

SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SCRIPT")/.." && pwd)"
DATA="$ROOT/.onyx-data"
PID_FILE="$DATA/onyx-dev.pid"
LOG_DIR="$DATA/logs"
LOG_FILE="$LOG_DIR/onyx-dev.log"
API_URL="${ONYX_API_URL:-http://127.0.0.1:4000}"
WEB_URL="${ONYX_WEB_URL:-http://127.0.0.1:3000}"
SERVICES=(onyx-api.service onyx-web.service)
COMMANDS=(onyx-start onyx-stop onyx-restart onyx-update onyx-status onyx-logs)

if [ -t 1 ]; then
  BOLD=$'\033[1m'
  ACCENT=$'\033[1;35m'
  GREEN=$'\033[1;32m'
  YELLOW=$'\033[1;33m'
  RED=$'\033[1;31m'
  RESET=$'\033[0m'
else
  BOLD=""
  ACCENT=""
  GREEN=""
  YELLOW=""
  RED=""
  RESET=""
fi

step() { printf '%s==>%s %s%s%s\n' "$ACCENT" "$RESET" "$BOLD" "$*" "$RESET"; }
info() { printf '    %s\n' "$*"; }
ok() { printf '%s✓%s %s\n' "$GREEN" "$RESET" "$*"; }
warn() { printf '%swarning:%s %s\n' "$YELLOW" "$RESET" "$*" >&2; }
fail() {
  printf '%serror:%s %s\n' "$RED" "$RESET" "$*" >&2
  exit 1
}
has() { command -v "$1" >/dev/null 2>&1; }

usage() {
  cat <<'USAGE'
Usage: onyx <command>    (or onyx-start, onyx-stop, onyx-update, …)

  start      start Onyx (systemd services, or pnpm dev in the background)
  stop       stop Onyx
  restart    stop, then start
  update     pull the latest code, install, migrate, rebuild and restart
  status     show whether Onyx is running and where to reach it
  logs       follow the logs
  install    put onyx-start, onyx-stop, onyx-update, onyx-restart,
             onyx-status and onyx-logs on the PATH

Onyx runs as systemd services when onyx-api.service is installed
(deploy/lxc/bootstrap.sh); otherwise it runs pnpm dev from this checkout.
Set ONYX_MODE=service or ONYX_MODE=dev to choose explicitly.
USAGE
}

as_root() {
  if [ "$(id -u)" -eq 0 ]; then
    "$@"
  elif has sudo; then
    sudo "$@"
  else
    fail "this needs root: run it again as root"
  fi
}

mode() {
  if [ -n "${ONYX_MODE:-}" ]; then
    printf '%s\n' "$ONYX_MODE"
  elif has systemctl && systemctl list-unit-files onyx-api.service 2>/dev/null | grep -q '^onyx-api.service'; then
    printf 'service\n'
  else
    printf 'dev\n'
  fi
}

lan_urls() {
  local port="$1"
  local address
  for address in $(hostname -I 2>/dev/null); do
    case "$address" in
      *:*) printf '      http://[%s]%s\n' "$address" "$port" ;;
      *) printf '      http://%s%s\n' "$address" "$port" ;;
    esac
  done
}

wait_for() {
  local url="$1"
  local seconds="$2"
  local elapsed=0
  while [ "$elapsed" -lt "$seconds" ]; do
    if curl --noproxy '*' -fsS -o /dev/null --max-time 2 "$url" 2>/dev/null; then return 0; fi
    sleep 1
    elapsed=$((elapsed + 1))
  done
  return 1
}

dev_pid() {
  if [ -f "$PID_FILE" ]; then
    local pid
    pid="$(cat "$PID_FILE")"
    if [ -n "$pid" ] && pgrep -s "$pid" >/dev/null 2>&1; then
      printf '%s\n' "$pid"
      return 0
    fi
  fi
  return 1
}

load_dev_env() {
  if [ -f "$ROOT/apps/api/.env" ]; then
    set -a
    . "$ROOT/apps/api/.env"
    set +a
  fi
}

dev_start() {
  local pid
  if pid="$(dev_pid)"; then
    ok "Onyx is already running (pid $pid)"
    dev_status
    return 0
  fi
  [ -d "$ROOT/node_modules" ] || fail "dependencies are missing: run scripts/install.sh first"
  [ -f "$ROOT/apps/api/.env" ] || fail "apps/api/.env is missing: run scripts/dev-setup.sh first"
  has pnpm || fail "pnpm is not on the PATH"
  mkdir -p "$LOG_DIR"
  step "Starting Onyx (pnpm dev)"
  (cd "$ROOT" && exec nohup setsid pnpm dev) >>"$LOG_FILE" 2>&1 < /dev/null &
  printf '%s\n' "$!" > "$PID_FILE"
  info "logs: $LOG_FILE"
  if wait_for "$API_URL/api/health" 90; then ok "API ready"; else warn "the API did not answer within 90 s: check onyx-logs"; fi
  if wait_for "$WEB_URL" 120; then ok "Web console ready"; else warn "the web console did not answer within 120 s: check onyx-logs"; fi
  dev_status
}

dev_stop() {
  local pid
  if ! pid="$(dev_pid)"; then
    rm -f "$PID_FILE"
    ok "Onyx is not running"
    return 0
  fi
  step "Stopping Onyx (pid $pid)"
  pkill -TERM -s "$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
  local waited=0
  while pgrep -s "$pid" >/dev/null 2>&1 && [ "$waited" -lt 20 ]; do
    sleep 1
    waited=$((waited + 1))
  done
  if pgrep -s "$pid" >/dev/null 2>&1; then
    warn "still running after 20 s: forcing it to stop"
    pkill -KILL -s "$pid" 2>/dev/null || true
  fi
  rm -f "$PID_FILE"
  ok "Onyx stopped"
}

dev_status() {
  local pid
  if pid="$(dev_pid)"; then
    ok "running in development mode (pid $pid)"
  else
    printf '%s•%s not running (development mode)\n' "$YELLOW" "$RESET"
    return 0
  fi
  if curl --noproxy '*' -fsS -o /dev/null --max-time 2 "$API_URL/api/health" 2>/dev/null; then info "API      $API_URL  ok"; else info "API      $API_URL  not answering"; fi
  info "Console  open one of:"
  lan_urls ":3000"
}

dev_update() {
  local was_running=false
  if dev_pid >/dev/null; then was_running=true; fi
  step "Updating the code"
  if git -C "$ROOT" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
    git -C "$ROOT" pull --ff-only
  else
    warn "the current branch has no upstream: skipping git pull"
  fi
  step "Installing dependencies"
  (cd "$ROOT" && pnpm install --frozen-lockfile)
  step "Migrating the database"
  load_dev_env
  [ -n "${DATABASE_URL:-}" ] || fail "DATABASE_URL is not set in apps/api/.env"
  (cd "$ROOT" && DATABASE_URL="$DATABASE_URL" pnpm --filter @onyx/db migrate:deploy)
  step "Building the MCP server"
  (cd "$ROOT" && pnpm --filter @onyx/mcp-server build)
  if $was_running; then
    dev_stop
    dev_start
  else
    ok "Updated. Start Onyx with: onyx-start"
  fi
}

service_start() {
  step "Starting Onyx services"
  as_root systemctl start "${SERVICES[@]}"
  if has caddy; then as_root systemctl start caddy.service 2>/dev/null || true; fi
  if wait_for "$API_URL/api/health" 60; then ok "API ready"; else warn "the API did not answer: journalctl -u onyx-api"; fi
  service_status
}

service_stop() {
  step "Stopping Onyx services"
  as_root systemctl stop onyx-web.service onyx-api.service
  ok "Onyx stopped"
}

service_status() {
  local unit
  for unit in "${SERVICES[@]}"; do
    if systemctl is-active --quiet "$unit"; then ok "$unit active"; else printf '%s•%s %s %s\n' "$YELLOW" "$RESET" "$unit" "$(systemctl is-active "$unit" 2>/dev/null || true)"; fi
  done
  if [ -L /opt/onyx/current ]; then info "release  $(basename "$(readlink -f /opt/onyx/current)")"; fi
  info "Console  open one of:"
  lan_urls ""
  info "      http://$(hostname).local"
}

service_update() {
  step "Updating the code in $ROOT"
  if git -C "$ROOT" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
    git -C "$ROOT" pull --ff-only
  else
    warn "the current branch has no upstream: skipping git pull"
  fi
  local stage
  stage="$(mktemp -d /tmp/onyx-release-XXXXXX)"
  step "Building a release"
  "$ROOT/deploy/scripts/build.sh" "$stage/release"
  step "Installing the release"
  as_root "$ROOT/deploy/scripts/release.sh" "$stage/release"
  rm -rf "$stage"
  if [ -d /opt/onyx/releases ]; then
    local old
    old="$(find /opt/onyx/releases -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' 2>/dev/null | sort -rn | awk 'NR > 3 { print $2 }')"
    if [ -n "$old" ]; then
      info "removing old releases"
      printf '%s\n' "$old" | while read -r dir; do as_root rm -rf "$dir"; done
    fi
  fi
  ok "Onyx updated"
  service_status
}

logs() {
  if [ "$(mode)" = service ]; then
    as_root journalctl -f -u onyx-api.service -u onyx-web.service
  else
    [ -f "$LOG_FILE" ] || fail "no log yet: start Onyx with onyx-start"
    tail -n 200 -f "$LOG_FILE"
  fi
}

install_commands() {
  local target
  if [ "$(id -u)" -eq 0 ]; then
    target=/usr/local/bin
  else
    target="$HOME/.local/bin"
  fi
  mkdir -p "$target"
  chmod +x "$SCRIPT"
  ln -sfn "$SCRIPT" "$target/onyx"
  local name
  for name in "${COMMANDS[@]}"; do ln -sfn "$SCRIPT" "$target/$name"; done
  ok "installed onyx, ${COMMANDS[*]} in $target"
  case ":$PATH:" in
    *":$target:"*) ;;
    *) warn "$target is not in your PATH: add  export PATH=\"$target:\$PATH\"  to your shell profile" ;;
  esac
}

run() {
  local command="$1"
  local current
  current="$(mode)"
  case "$command" in
    start) if [ "$current" = service ]; then service_start; else dev_start; fi ;;
    stop) if [ "$current" = service ]; then service_stop; else dev_stop; fi ;;
    restart)
      run stop
      run start
      ;;
    update) if [ "$current" = service ]; then service_update; else dev_update; fi ;;
    status) if [ "$current" = service ]; then service_status; else dev_status; fi ;;
    logs) logs ;;
    install) install_commands ;;
    -h | --help | help) usage ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
}

invoked="$(basename "$0")"
case "$invoked" in
  onyx-*) run "${invoked#onyx-}" ;;
  *)
    if [ $# -eq 0 ]; then
      usage
      exit 0
    fi
    run "$1"
    ;;
esac
