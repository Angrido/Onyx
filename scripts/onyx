#!/usr/bin/env bash
set -euo pipefail

SCRIPT="$(readlink -f "${BASH_SOURCE[0]}")"
ROOT="$(cd "$(dirname "$SCRIPT")/.." && pwd)"
DATA="$ROOT/.onyx-data"
PID_FILE="$DATA/onyx-dev.pid"
LOG_DIR="$DATA/logs"
LOG_FILE="$LOG_DIR/onyx-dev.log"
API_URL="${ONYX_API_URL:-http://127.0.0.1:4000}"
WEB_URL="${ONYX_WEB_URL:-http://127.0.0.1:3000}"
SERVICES=(onyx-api.service onyx-web.service)
COMMANDS=(onyx-start onyx-stop onyx-restart onyx-update onyx-status onyx-logs onyx-use-claude onyx-update-claude onyx-backup onyx-restore)
STUB_BIN="$ROOT/packages/agent-runtime/bin/claude-stub.ts"
SERVICE_ENV=/etc/onyx/onyx.env

if [ -t 1 ]; then
  BOLD=$'\033[1m'
  ACCENT=$'\033[1;35m'
  GREEN=$'\033[1;32m'
  YELLOW=$'\033[1;33m'
  RED=$'\033[1;31m'
  RESET=$'\033[0m'
else
  BOLD=""
  ACCENT=""
  GREEN=""
  YELLOW=""
  RED=""
  RESET=""
fi

step() { printf '%s==>%s %s%s%s\n' "$ACCENT" "$RESET" "$BOLD" "$*" "$RESET"; }
info() { printf '    %s\n' "$*"; }
ok() { printf '%s✓%s %s\n' "$GREEN" "$RESET" "$*"; }
warn() { printf '%swarning:%s %s\n' "$YELLOW" "$RESET" "$*" >&2; }
fail() {
  printf '%serror:%s %s\n' "$RED" "$RESET" "$*" >&2
  exit 1
}
has() { command -v "$1" >/dev/null 2>&1; }

usage() {
  cat <<'USAGE'
Usage: onyx <command>    (or onyx-start, onyx-stop, onyx-update, …)

  start      start Onyx (systemd services, or pnpm dev in the background)
  stop       stop Onyx
  restart    stop, then start
  update     pull the latest code, install, migrate, rebuild and restart
  status     show whether Onyx is running and where to reach it
  logs       follow the logs
  use-claude use the real Claude Code (installed if missing), so Onyx can
             sign in with your Claude account; restarts Onyx
  use-stub   go back to the bundled simulator (development and tests)
  update-claude
             update Claude Code, check that it accepts every option Onyx
             passes (no request is sent) and restart Onyx
  backup     write a backup of the database now
  backups    list the backups
  restore [name|latest]
             stop Onyx, save the current database, restore the backup,
             apply the migrations and start Onyx again
  install    put onyx-start, onyx-stop, onyx-update, onyx-restart,
             onyx-status, onyx-logs, onyx-use-claude, onyx-backup and
             onyx-restore on the PATH

Onyx runs as systemd services when onyx-api.service is installed
(deploy/lxc/bootstrap.sh); otherwise it runs pnpm dev from this checkout.
Set ONYX_MODE=service or ONYX_MODE=dev to choose explicitly.
USAGE
}

as_root() {
  if [ "$(id -u)" -eq 0 ]; then
    "$@"
  elif has sudo; then
    sudo "$@"
  else
    fail "this needs root: run it again as root"
  fi
}

mode() {
  if [ -n "${ONYX_MODE:-}" ]; then
    printf '%s\n' "$ONYX_MODE"
  elif has systemctl && systemctl list-unit-files onyx-api.service 2>/dev/null | grep -q '^onyx-api.service'; then
    printf 'service\n'
  else
    printf 'dev\n'
  fi
}

lan_urls() {
  local port="$1"
  local address
  for address in $(hostname -I 2>/dev/null); do
    case "$address" in
      *:*) printf '      http://[%s]%s\n' "$address" "$port" ;;
      *) printf '      http://%s%s\n' "$address" "$port" ;;
    esac
  done
}

wait_for() {
  local url="$1"
  local seconds="$2"
  local elapsed=0
  while [ "$elapsed" -lt "$seconds" ]; do
    if curl --noproxy '*' -fsS -o /dev/null --max-time 2 "$url" 2>/dev/null; then return 0; fi
    sleep 1
    elapsed=$((elapsed + 1))
  done
  return 1
}

dev_pid() {
  if [ -f "$PID_FILE" ]; then
    local pid
    pid="$(cat "$PID_FILE")"
    if [ -n "$pid" ] && pgrep -s "$pid" >/dev/null 2>&1; then
      printf '%s\n' "$pid"
      return 0
    fi
  fi
  return 1
}

env_file() {
  if [ "$(mode)" = service ]; then printf '%s\n' "$SERVICE_ENV"; else printf '%s\n' "$ROOT/apps/api/.env"; fi
}

env_value() {
  local file="$1"
  local key="$2"
  [ -r "$file" ] || return 0
  sed -n "s/^${key}=//p" "$file" | tail -n 1
}

set_env_value() {
  local file="$1"
  local key="$2"
  local value="$3"
  local temp
  temp="$(mktemp)"
  if [ -f "$file" ]; then
    awk -v key="$key" -v value="$value" 'BEGIN { done = 0 } index($0, key "=") == 1 { if (!done) print key "=" value; done = 1; next } { print } END { if (!done) print key "=" value }' "$file" > "$temp"
  else
    printf '%s=%s\n' "$key" "$value" > "$temp"
  fi
  if [ -w "$file" ] || { [ ! -e "$file" ] && [ -w "$(dirname "$file")" ]; }; then
    cat "$temp" > "$file"
  else
    as_root cp "$temp" "$file"
  fi
  rm -f "$temp"
}

claude_bin() {
  env_value "$(env_file)" CLAUDE_BIN
}

is_stub() {
  case "$1" in
    *claude-stub*) return 0 ;;
    *) return 1 ;;
  esac
}

claude_line() {
  local bin
  bin="$(claude_bin)"
  if [ -z "$bin" ]; then
    info "Claude   not configured (CLAUDE_BIN missing in $(env_file))"
  elif is_stub "$bin"; then
    printf '    %sClaude   simulator (no real agents, no real sign-in): run onyx use-claude%s\n' "$YELLOW" "$RESET"
  else
    info "Claude   $bin"
  fi
}

find_claude() {
  if [ "$(mode)" = service ]; then
    runuser -u onyx -- bash -lc 'command -v claude || { [ -x "$HOME/.local/bin/claude" ] && printf "%s\n" "$HOME/.local/bin/claude"; }' 2>/dev/null
  else
    command -v claude 2>/dev/null || { [ -x "$HOME/.local/bin/claude" ] && printf '%s\n' "$HOME/.local/bin/claude"; }
  fi
}

install_claude() {
  step "Installing Claude Code"
  has curl || fail "curl is needed to install Claude Code"
  if [ "$(mode)" = service ]; then
    as_root runuser -u onyx -- bash -lc 'curl -fsSL https://claude.ai/install.sh | bash'
  else
    curl -fsSL https://claude.ai/install.sh | bash
  fi
}

restart_if_running() {
  local running=false
  if [ "$(mode)" = service ]; then
    if systemctl is-active --quiet onyx-api.service; then running=true; fi
  elif dev_pid >/dev/null; then
    running=true
  fi
  if $running; then
    run restart
  else
    info "Start Onyx with: onyx-start"
  fi
}

use_claude() {
  local bin
  bin="$(find_claude || true)"
  if [ -z "$bin" ]; then
    install_claude
    bin="$(find_claude || true)"
  fi
  [ -n "$bin" ] || fail "Claude Code is still missing: install it with  curl -fsSL https://claude.ai/install.sh | bash"
  local version
  version="$("$bin" --version 2>/dev/null | awk 'NR == 1' || true)"
  step "Using Claude Code ${version:-at $bin}"
  set_env_value "$(env_file)" CLAUDE_BIN "$bin"
  ok "CLAUDE_BIN=$bin in $(env_file)"
  restart_if_running
  printf '\nOpen Settings in the console and press %sSign in with Claude%s.\n' "$BOLD" "$RESET"
}

update_claude() {
  local bin before after
  bin="$(claude_bin)"
  [ -n "$bin" ] || fail "CLAUDE_BIN is not set: run onyx use-claude first"
  if is_stub "$bin"; then fail "Onyx uses the simulator: run onyx use-claude first"; fi
  before="$("$bin" --version 2>/dev/null | awk 'NR == 1' || true)"
  step "Updating Claude Code (${before:-unknown version})"
  if [ "$(mode)" = service ]; then
    as_root runuser -u onyx -- env DISABLE_AUTOUPDATER=0 "$bin" update
  else
    DISABLE_AUTOUPDATER=0 "$bin" update
  fi
  after="$("$bin" --version 2>/dev/null | awk 'NR == 1' || true)"
  if [ "$before" = "$after" ]; then ok "Claude Code is already up to date (${after:-?})"; else ok "Claude Code $before -> $after"; fi
  step "Checking Claude Code with Onyx"
  if ! onyx_cli check-claude; then
    warn "this Claude Code version lacks options Onyx needs: update Onyx (onyx-update) or go back with: $bin install ${before%% *}"
  fi
  restart_if_running
  if [ "$before" != "$after" ] && [ "$(mode)" = dev ]; then
    info "To record fresh transcripts for the contract tests (spends a few cents of Claude usage):"
    info "  pnpm --filter @onyx/agent-runtime fixtures:record -- --yes"
  fi
}

use_stub() {
  [ "$(mode)" = dev ] || fail "the simulator is only available in a development checkout"
  step "Using the Claude Code simulator"
  set_env_value "$(env_file)" CLAUDE_BIN "$STUB_BIN"
  ok "CLAUDE_BIN=$STUB_BIN"
  restart_if_running
}

onyx_cli() {
  if [ "$(mode)" = service ]; then
    as_root runuser -u onyx -- bash -c 'set -a; . /etc/onyx/onyx.env; set +a; cd /opt/onyx/current/api && exec node dist/cli.js "$@"' onyx-cli "$@"
  else
    [ -f "$ROOT/apps/api/.env" ] || fail "apps/api/.env is missing: run scripts/dev-setup.sh first"
    (
      set -a
      . "$ROOT/apps/api/.env"
      set +a
      cd "$ROOT/apps/api" && exec ./node_modules/.bin/tsx src/cli.ts "$@"
    )
  fi
}

is_running() {
  if [ "$(mode)" = service ]; then
    systemctl is-active --quiet onyx-api.service
  else
    dev_pid >/dev/null
  fi
}

migrate() {
  if [ "$(mode)" = service ]; then
    as_root bash -c 'set -a; . /etc/onyx/onyx.env; set +a; cd /opt/onyx/current/db && runuser -u onyx -- env DATABASE_URL="$DATABASE_URL" ./node_modules/.bin/prisma migrate deploy'
  else
    load_dev_env
    [ -n "${DATABASE_URL:-}" ] || fail "DATABASE_URL is not set in apps/api/.env"
    (cd "$ROOT" && DATABASE_URL="$DATABASE_URL" pnpm --filter @onyx/db migrate:deploy)
  fi
}

backup_now() {
  step "Backing up the database"
  onyx_cli backup --reason "${1:-manual}"
}

restore_backup() {
  local reference="${1:-}"
  if [ -z "$reference" ]; then
    onyx_cli list
    printf '
Choose one: onyx restore <name>   (or onyx restore latest)
'
    return 0
  fi
  onyx_cli verify "$reference" || fail "the backup is damaged: nothing was changed"
  local was_running=false
  if is_running; then
    was_running=true
    run stop
  fi
  step "Restoring $reference"
  onyx_cli restore "$reference"
  step "Applying the migrations"
  migrate
  if $was_running; then
    run start
  else
    ok "Restored. Start Onyx with: onyx-start"
  fi
}

load_dev_env() {
  if [ -f "$ROOT/apps/api/.env" ]; then
    set -a
    . "$ROOT/apps/api/.env"
    set +a
  fi
}

dev_start() {
  local pid
  if pid="$(dev_pid)"; then
    ok "Onyx is already running (pid $pid)"
    dev_status
    return 0
  fi
  [ -d "$ROOT/node_modules" ] || fail "dependencies are missing: run scripts/install.sh first"
  [ -f "$ROOT/apps/api/.env" ] || fail "apps/api/.env is missing: run scripts/dev-setup.sh first"
  has pnpm || fail "pnpm is not on the PATH"
  mkdir -p "$LOG_DIR"
  step "Starting Onyx (pnpm dev)"
  (cd "$ROOT" && exec nohup setsid pnpm dev) >>"$LOG_FILE" 2>&1 < /dev/null &
  printf '%s\n' "$!" > "$PID_FILE"
  info "logs: $LOG_FILE"
  if wait_for "$API_URL/api/health" 90; then ok "API ready"; else warn "the API did not answer within 90 s: check onyx-logs"; fi
  if wait_for "$WEB_URL" 120; then ok "Web console ready"; else warn "the web console did not answer within 120 s: check onyx-logs"; fi
  dev_status
}

dev_stop() {
  local pid
  if ! pid="$(dev_pid)"; then
    rm -f "$PID_FILE"
    ok "Onyx is not running"
    return 0
  fi
  step "Stopping Onyx (pid $pid)"
  pkill -TERM -s "$pid" 2>/dev/null || kill -TERM "$pid" 2>/dev/null || true
  local waited=0
  while pgrep -s "$pid" >/dev/null 2>&1 && [ "$waited" -lt 20 ]; do
    sleep 1
    waited=$((waited + 1))
  done
  if pgrep -s "$pid" >/dev/null 2>&1; then
    warn "still running after 20 s: forcing it to stop"
    pkill -KILL -s "$pid" 2>/dev/null || true
  fi
  rm -f "$PID_FILE"
  ok "Onyx stopped"
}

dev_status() {
  local pid
  if pid="$(dev_pid)"; then
    ok "running in development mode (pid $pid)"
  else
    printf '%s•%s not running (development mode)\n' "$YELLOW" "$RESET"
    claude_line
    return 0
  fi
  if curl --noproxy '*' -fsS -o /dev/null --max-time 2 "$API_URL/api/health" 2>/dev/null; then info "API      $API_URL  ok"; else info "API      $API_URL  not answering"; fi
  claude_line
  info "Console  open one of:"
  lan_urls ":3000"
}

dev_update_steps() {
  step "Updating the code"
  if git -C "$ROOT" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
    git -C "$ROOT" pull --ff-only || return 1
  else
    warn "the current branch has no upstream: skipping git pull"
  fi
  step "Installing dependencies"
  (cd "$ROOT" && pnpm install --frozen-lockfile) || return 1
  load_dev_env
  if [ -n "${DATABASE_URL:-}" ] && [ -f "${DATABASE_URL#file:}" ]; then
    backup_now pre-update || warn "the backup before the update failed: continuing"
  fi
  step "Migrating the database"
  if [ -z "${DATABASE_URL:-}" ]; then
    warn "DATABASE_URL is not set in apps/api/.env"
    return 1
  fi
  (cd "$ROOT" && DATABASE_URL="$DATABASE_URL" pnpm --filter @onyx/db migrate:deploy) || return 1
  step "Building the MCP server"
  (cd "$ROOT" && pnpm --filter @onyx/mcp-server build) || return 1
}

dev_update() {
  local was_running=false
  if dev_pid >/dev/null; then
    was_running=true
    dev_stop
  fi
  if ! dev_update_steps; then
    if $was_running; then warn "Onyx was stopped for the update and is still stopped"; fi
    fail "the update did not finish: fix the error above and run onyx-update again (the backup written before the update is listed by onyx backups)"
  fi
  if $was_running; then
    dev_start
  else
    ok "Updated. Start Onyx with: onyx-start"
  fi
  install_commands >/dev/null || true
  if is_stub "$(claude_bin)"; then
    warn "Onyx is using the Claude Code simulator: run onyx use-claude to sign in with your Claude account"
  fi
}

service_start() {
  step "Starting Onyx services"
  as_root systemctl start "${SERVICES[@]}"
  if has caddy; then as_root systemctl start caddy.service 2>/dev/null || true; fi
  if wait_for "$API_URL/api/health" 60; then ok "API ready"; else warn "the API did not answer: journalctl -u onyx-api"; fi
  service_status
}

service_stop() {
  step "Stopping Onyx services"
  as_root systemctl stop onyx-web.service onyx-api.service
  ok "Onyx stopped"
}

service_status() {
  local unit
  for unit in "${SERVICES[@]}"; do
    if systemctl is-active --quiet "$unit"; then ok "$unit active"; else printf '%s•%s %s %s\n' "$YELLOW" "$RESET" "$unit" "$(systemctl is-active "$unit" 2>/dev/null || true)"; fi
  done
  if [ -L /opt/onyx/current ]; then info "release  $(basename "$(readlink -f /opt/onyx/current)")"; fi
  claude_line
  info "Console  open one of:"
  lan_urls ""
  info "      http://$(hostname).local"
}

service_update() {
  step "Updating the code in $ROOT"
  if git -C "$ROOT" rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1; then
    git -C "$ROOT" pull --ff-only
  else
    warn "the current branch has no upstream: skipping git pull"
  fi
  local stage
  stage="$(mktemp -d /tmp/onyx-release-XXXXXX)"
  step "Building a release"
  "$ROOT/deploy/scripts/build.sh" "$stage/release"
  step "Installing the release"
  as_root "$ROOT/deploy/scripts/release.sh" "$stage/release"
  rm -rf "$stage"
  if [ -d /opt/onyx/releases ]; then
    local old
    old="$(find /opt/onyx/releases -mindepth 1 -maxdepth 1 -type d -printf '%T@ %p\n' 2>/dev/null | sort -rn | awk 'NR > 3 { print $2 }')"
    if [ -n "$old" ]; then
      info "removing old releases"
      printf '%s\n' "$old" | while read -r dir; do as_root rm -rf "$dir"; done
    fi
  fi
  install_commands >/dev/null || true
  ok "Onyx updated"
  service_status
}

logs() {
  if [ "$(mode)" = service ]; then
    as_root journalctl -f -u onyx-api.service -u onyx-web.service
  else
    [ -f "$LOG_FILE" ] || fail "no log yet: start Onyx with onyx-start"
    tail -n 200 -f "$LOG_FILE"
  fi
}

install_commands() {
  local target
  if [ "$(id -u)" -eq 0 ]; then
    target=/usr/local/bin
  else
    target="$HOME/.local/bin"
  fi
  mkdir -p "$target"
  chmod +x "$SCRIPT"
  ln -sfn "$SCRIPT" "$target/onyx"
  local name
  for name in "${COMMANDS[@]}"; do ln -sfn "$SCRIPT" "$target/$name"; done
  ok "installed onyx, ${COMMANDS[*]} in $target"
  case ":$PATH:" in
    *":$target:"*) ;;
    *) warn "$target is not in your PATH: add  export PATH=\"$target:\$PATH\"  to your shell profile" ;;
  esac
}

run() {
  local command="$1"
  local current
  current="$(mode)"
  case "$command" in
    start) if [ "$current" = service ]; then service_start; else dev_start; fi ;;
    stop) if [ "$current" = service ]; then service_stop; else dev_stop; fi ;;
    restart)
      run stop
      run start
      ;;
    update) if [ "$current" = service ]; then service_update; else dev_update; fi ;;
    status) if [ "$current" = service ]; then service_status; else dev_status; fi ;;
    logs) logs ;;
    use-claude) use_claude ;;
    use-stub) use_stub ;;
    update-claude) update_claude ;;
    backup) backup_now manual ;;
    backups) onyx_cli list ;;
    restore) restore_backup "${2:-}" ;;
    install) install_commands ;;
    -h | --help | help) usage ;;
    *)
      usage >&2
      exit 1
      ;;
  esac
}

invoked="$(basename "$0")"
case "$invoked" in
  onyx-*) run "${invoked#onyx-}" "${1:-}" ;;
  *)
    if [ $# -eq 0 ]; then
      usage
      exit 0
    fi
    run "$1" "${2:-}"
    ;;
esac
