{
  "name": "onyx",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "eslint . --max-warnings=0",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @onyx/db generate",
    "db:migrate": "pnpm --filter @onyx/db migrate:deploy",
    "db:seed": "pnpm --filter @onyx/db seed",
    "postinstall": "pnpm --filter @onyx/db generate"
  },
  "devDependencies": {
    "@onyx/config": "workspace:*",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3"
  }
}
